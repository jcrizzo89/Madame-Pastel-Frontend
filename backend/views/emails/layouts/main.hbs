<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{subject}}</title>
  <style>
    body {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      margin: 0;
      padding: 0;
      background-color: #f8f8f8;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      background-color: #fff;
      border-radius: 8px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }
    .header {
      text-align: center;
      padding-bottom: 20px;
      border-bottom: 1px solid #f0f0f0;
    }
    .header img {
      max-width: 180px;
      margin-bottom: 10px;
    }
    .content {
      padding: 20px 0;
    }
    .footer {
      text-align: center;
      padding-top: 20px;
      border-top: 1px solid #f0f0f0;
      color: #999;
      font-size: 12px;
    }
    .social-links {
      margin-top: 15px;
    }
    .social-links a {
      display: inline-block;
      margin: 0 5px;
    }
    .btn {
      display: inline-block;
      padding: 10px 20px;
      background-color: #d94f70;
      color: #fff;
      text-decoration: none;
      border-radius: 4px;
      font-weight: 500;
    }
    .btn:hover {
      background-color: #c2405e;
    }
    h1, h2 {
      color: #d94f70;
    }
    p {
      margin-bottom: 15px;
    }
    .highlight {
      background-color: #fffbcc;
      padding: 15px;
      border-radius: 4px;
      margin: 15px 0;
    }
    .product-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
      margin: 20px 0;
    }
    .product-item {
      border: 1px solid #eee;
      border-radius: 4px;
      padding: 10px;
      text-align: center;
    }
    .product-item img {
      max-width: 100%;
      height: auto;
      border-radius: 4px;
    }
    @media (max-width: 600px) {
      .container {
        width: 100%;
        border-radius: 0;
      }
      .product-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <img src="{{storeLogo}}" alt="{{storeName}}" />
      <h1>{{storeName}}</h1>
    </div>
    
    <div class="content">
      {{{body}}}
    </div>
    
    <div class="footer">
      <p>© {{currentYear}} {{storeName}}. Todos los derechos reservados.</p>
      <p>{{storeAddress}}</p>
      <p>
        <a href="mailto:{{storeEmail}}">{{storeEmail}}</a> | 
        <a href="tel:{{storePhone}}">{{storePhone}}</a>
      </p>
      
      <div class="social-links">
        {{#if instagramLink}}
        <a href="{{instagramLink}}" target="_blank">Instagram</a>
        {{/if}}
        {{#if facebookLink}}
        <a href="{{facebookLink}}" target="_blank">Facebook</a>
        {{/if}}
        {{#if twitterLink}}
        <a href="{{twitterLink}}" target="_blank">Twitter</a>
        {{/if}}
      </div>
      
      <p>
        <small>Si no deseas recibir más correos de nuestra parte, haz clic <a href="{{unsubscribeLink}}">aquí</a>.</small>
      </p>
    </div>
  </div>
</body>
</html>
